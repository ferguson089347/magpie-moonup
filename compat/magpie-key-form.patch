+// Key-form hints are display data; no secret or executable URL crosses to the GUI.
+function keyFormOf(form) {
+  let keysURL = ""
+  try {
+    const url = new URL(form.keysURL)
+    if (["https:", "http:"].includes(url.protocol) && !url.username && !url.password) keysURL = url.href
+  } catch {}
+  const seen = new Set()
+  const protocols = (Array.isArray(form.protocols) ? form.protocols : []).slice(0, 10).flatMap((p) => {
+    if (typeof p?.value !== "string" || p.value.length > 100 || !shown(p.label, 100) || seen.has(p.value)) return []
+    seen.add(p.value)
+    return [{ label: shown(p.label, 100), value: p.value }]
+  })
+  return { keysURL, protocols }
 }
 
