+// Native plugin Key forms keep legacy accounts and use the plugin sign-in API.
+// Every request is intercepted; no real gateway, credential file or vendor is used.
+const assert = require("node:assert/strict");
+const fs = require("node:fs/promises");
+const path = require("node:path");
+const { test } = require("node:test");
+const { chromium, webkit } = require("playwright");
+const assets = process.env.MAGPIE_KEY_FORM_ASSETS || path.resolve(__dirname, "../assets");
+const legacy = "moonup.dev …cbed · 69456bde";
+const method = { type: "api", label: "moonup API key", keyForm: {
+  keysURL: "https://moonup.dev/keys",
+  protocols: [{ label: "Any protocol", value: "" }, { label: "Anthropic", value: "anthropic_messages" }, { label: "Responses", value: "openai_responses" }],
+} };
+
+function serve(lang, posts, accounts) {
+  let rejected = false;
+  const payload = () => ({
+    providers: [{ id: "moonup", name: "moonup", icon: "generic", models: [], agents: [], key: {},
+      account: { agent: "moonup", agentName: "moonup", user: accounts[0], logins: accounts.map((user, i) => ({ user, active: i === 0, on: true })) } }],
+    presets: [], excluded: [], gateway: { running: true, window: true },
+    plugins: [{ id: "moonup", pid: "moonup", name: "moonup", icon: "generic", spec: "magpie-moonup", methods: [method], signedIn: true }],
+  });
+  return async (route) => {
+    const url = new URL(route.request().url());
+    const json = (data) => route.fulfill({ json: data });
+    if (url.pathname === "/boot.js") return route.fulfill({ contentType: "text/javascript", body: `window.bootPrefs = {lang:${JSON.stringify(lang)},theme:"light",web:false};` });
+    if (url.pathname === "/wails/runtime.js") return route.fulfill({ contentType: "text/javascript", body: "export const Window = {};" });
+    if (url.pathname === "/api/state") return json({ agents: [], profiles: [], settings: { lang, theme: "light" } });
+    if (url.pathname === "/api/providers") return json(payload());
+    if (url.pathname === "/api/groups") return json({ groups: [], pools: [] });
+    if (url.pathname === "/api/plugin-signin/prompt") return json({ prompt: null, inputs: {} });
+    if (route.request().method() === "POST") {
+      const body = route.request().postDataJSON();
+      posts.push({ path: url.pathname, body });
+      if (url.pathname === "/api/plugin-signin") {
+        if (body.key === "sk-retry" && !rejected) {
+          rejected = true;
+          return route.fulfill({ status: 400, json: { error: "Temporary failure" } });
+        }
+        const user = body.inputs.name || body.key;
+        if (!accounts.includes(user)) accounts.push(user);
+        return json({ agent: "moonup", state: "done", user });
+      }
+      return json({});
+    }
+    if (url.pathname.startsWith("/api/")) return json({});
+    const file = path.join(assets, url.pathname === "/" ? "index.html" : url.pathname);
+    const contentType = { ".html": "text/html", ".js": "text/javascript", ".css": "text/css", ".svg": "image/svg+xml", ".png": "image/png" }[path.extname(file)];
+    try { await route.fulfill({ body: await fs.readFile(file), contentType }); }
+    catch { await route.fulfill({ status: 404, body: "" }); }
+  };
+}
+
+for (const engine of (process.env.BROWSER ? [process.env.BROWSER] : ["chromium", "webkit"])) {
+  test(engine + ": native plugin Key form", async (t) => {
+    const browser = await (engine === "webkit" ? webkit.launch() : chromium.launch({ channel: "chromium" }));
+    t.after(() => browser.close());
+    for (const lang of ["en", "zh", "zh-TW", "ja", "de"]) {
+      for (const width of [420, 1100]) await t.test(`${lang} ${width}`, async () => {
+        const page = await (await browser.newContext({ viewport: { width, height: 850 }, reducedMotion: "reduce" })).newPage();
+        page.setDefaultTimeout(6000);
+        t.after(() => page.close());
+        const posts = [], accounts = [legacy], errors = [];
+        page.on("pageerror", (e) => errors.push(e.message));
+        await page.route("**/*", serve(lang, posts, accounts));
+        await page.goto("http://magpie.test/?view=providers");
+        await page.locator(".row.provider", { hasText: "moonup" }).click();
+        const tr = (key) => page.evaluate((key) => t(key), key);
+        const another = await tr("Add another key");
+        await page.getByRole("button", { name: another, exact: true }).click();
+        const form = page.locator(".plugin-key-form");
+        await form.waitFor();
+        const add = form.getByRole("button", { name: await tr("Add"), exact: true });
+        assert.equal(await add.isDisabled(), true);
+        await form.getByRole("button", { name: await tr("Get a key ↗"), exact: true }).click();
+        await page.waitForFunction(() => true);
+        await form.getByLabel(await tr("Name (optional), e.g. Team"), { exact: true }).fill("Team");
+        const key = form.getByLabel("moonup API key", { exact: true });
+        assert.equal(await key.getAttribute("type"), "password");
+        await key.fill("sk-team");
+        if (process.env.ARTIFACT_DIR) {
+          await fs.mkdir(process.env.ARTIFACT_DIR, { recursive: true });
+          await form.screenshot({ path: path.join(process.env.ARTIFACT_DIR, `plugin-key-form-before-${engine}-${lang}-${width}.png`) });
+        }
+        await form.locator(".proto").click();
+        await page.locator(".proto-menu .pm-item", { hasText: "Anthropic" }).click();
+        const rect = await form.boundingBox();
+        for (const field of await form.locator("input, button").all()) {
+          const r = await field.boundingBox();
+          assert.ok(r.x >= rect.x - 1 && r.x + r.width <= rect.x + rect.width + 1, "form control spills outside the row");
+        }
+        if (process.env.ARTIFACT_DIR) {
+          await fs.mkdir(process.env.ARTIFACT_DIR, { recursive: true });
+          await form.screenshot({ path: path.join(process.env.ARTIFACT_DIR, `plugin-key-form-${engine}-${lang}-${width}.png`) });
+        }
+        await add.click();
+        await page.waitForFunction(() => !document.querySelector(".plugin-key-form"));
+        assert.deepEqual(accounts, [legacy, "Team"]);
+        assert.deepEqual(posts.find((p) => p.path === "/api/plugin-signin").body, {
+          provider: "moonup", method: 0, inputs: { name: "Team", protocol: "anthropic_messages" }, key: "sk-team",
+        });
+        assert.ok(posts.some((p) => p.path === "/api/open" && p.body.url === "https://moonup.dev/keys"));
+        await page.getByRole("button", { name: another, exact: true }).click();
+        // Pasting several switches automatically and deduplicates the batch.
+        await form.getByRole("button", { name: await tr("Paste several"), exact: true }).click();
+        await form.locator("textarea").waitFor();
+        await form.getByRole("button", { name: await tr("Add one key"), exact: true }).click();
+        await form.getByLabel("moonup API key").evaluate((field) => {
+          const data = new DataTransfer();
+          data.setData("text/plain", "sk-before, sk-before; sk-retry\nsk-after");
+          field.dispatchEvent(new ClipboardEvent("paste", { bubbles: true, cancelable: true, clipboardData: data }));
+        });
+        const bulk = form.locator("textarea");
+        await bulk.waitFor();
+        await add.click();
+        await form.locator(".why", { hasText: "Temporary failure" }).waitFor();
+        assert.equal(await bulk.inputValue(), "sk-retry\nsk-after");
+        assert.deepEqual(accounts, [legacy, "Team", "sk-before"]);
+        await add.click();
+        await page.waitForFunction(() => !document.querySelector(".plugin-key-form"));
+        assert.deepEqual(accounts, [legacy, "Team", "sk-before", "sk-retry", "sk-after"]);
+        assert.equal(posts.filter((p) => p.path === "/api/plugin-signin" && p.body.key === "sk-before").length, 1);
+        await page.getByRole("button", { name: another, exact: true }).click();
+        await form.getByRole("button", { name: await tr("Cancel"), exact: true }).click();
+        assert.deepEqual(errors, []);
+      });
+    }
+  });
+}
