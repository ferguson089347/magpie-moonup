+package plugin
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+// Key forms are optional display hints. Existing methods keep their shape;
+// executable URLs and malformed protocol options never reach the GUI.
+func TestPluginKeyForm(t *testing.T) {
+	sandbox(t)
+	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
+	defer cancel()
+	dir := t.TempDir()
+	for name, body := range map[string]string{
+		"package.json": `{"name":"key-form-fixture","type":"module","main":"index.mjs"}`,
+		"index.mjs": `export const Forms = async () => ({
+  auth: { provider: "forms", methods: [
+    { type: "api", label: "Key", keyForm: {
+      keysURL: "https://forms.example/keys", protocols: [
+        {label:"Any protocol", value:""}, {label:"Anthropic", value:"anthropic_messages"},
+        {label:"Duplicate", value:"anthropic_messages"}, {label:"Bad", value:123}, null
+      ]
+    } },
+    { type: "api", label: "Unsafe", keyForm: {keysURL:"javascript:alert(1)"} },
+    { type: "oauth", label: "Browser", keyForm: {keysURL:"https://forms.example/keys"} }
+  ] }
+})`,
+	} {
+		if err := os.WriteFile(filepath.Join(dir, name), []byte(body), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err := Add(ctx, dir); err != nil {
+		t.Fatal(err)
+	}
+	providers, err := Providers(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, provider := range providers {
+		if provider.ID != "forms" {
+			continue
+		}
+		if len(provider.Methods) != 3 {
+			t.Fatalf("methods = %+v", provider.Methods)
+		}
+		form := provider.Methods[0].KeyForm
+		if form == nil || form.KeysURL != "https://forms.example/keys" || len(form.Protocols) != 2 {
+			t.Fatalf("key form = %+v", form)
+		}
+		if form.Protocols[1].Value != "anthropic_messages" {
+			t.Errorf("protocol = %+v", form.Protocols[1])
+		}
+		if bad := provider.Methods[1].KeyForm; bad == nil || bad.KeysURL != "" {
+			t.Errorf("executable key URL was not removed: %+v", bad)
+		}
+		if provider.Methods[2].KeyForm != nil {
+			t.Error("an OAuth method received a Key form")
+		}
+		return
+	}
+	t.Fatal("key form provider was not listed")
+}
